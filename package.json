{
  "name": "opendata-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "mcp": "tsx src/mcp/stdio.ts",
    "mcp:demo": "tsx src/mcp/demo.ts",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name datafit --branch main"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@observablehq/plot": "^0.6.17",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/point-to-line-distance": "^7.4.0",
    "3d-force-graph": "^1.80.1",
    "d3": "^7.9.0",
    "maplibre-gl": "^6.7.0",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.4.1",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
